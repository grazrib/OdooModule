<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         1. Estendi la vista LISTA di product.template
         ================================================================ -->
    <record id="product_template_list_inherit_label_tracking" model="ir.ui.view">
        <field name="name">product.template.list.inherit.label.tracking</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <!-- Aggiunge le colonne nella lista prodotti -->
            <xpath expr="//list" position="inside">
                <field name="label_printed" string="Stampata" optional="show"/>
                <field name="label_printed_date" string="Data stampa" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         2. Aggiungi filtri alla vista ricerca prodotti
         ================================================================ -->
    <record id="product_template_search_inherit_label_tracking" model="ir.ui.view">
        <field name="name">product.template.search.inherit.label.tracking</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search/filter[@name='inactive']" position="before">
                <!-- Filtro: prodotti non ancora stampati -->
                <filter string="Da Stampare"
                        name="label_not_printed"
                        domain="[('label_printed', '=', False)]"/>
                <!-- Filtro: prodotti già stampati -->
                <filter string="Già Stampati"
                        name="label_printed_filter"
                        domain="[('label_printed', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         3. Aggiungi badge nella form del prodotto
         ================================================================ -->
    <record id="product_template_form_inherit_label_tracking" model="ir.ui.view">
        <field name="name">product.template.form.inherit.label.tracking</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Stato: Stampata — cliccabile per fare toggle -->
                <button type="object" name="action_label_reset_printed"
                        class="oe_stat_button"
                        icon="fa-tag"
                        invisible="not label_printed">
                    <div class="o_stat_info">
                        <span class="o_stat_text text-success">Stampata</span>
                        <span class="o_stat_text" style="font-size:10px;">
                            <field name="label_printed_date" widget="date"/>
                        </span>
                    </div>
                </button>
                <!-- Stato: Da Stampare — cliccabile per fare toggle -->
                <button type="object" name="action_label_reset_printed"
                        class="oe_stat_button"
                        icon="fa-tag"
                        invisible="label_printed">
                    <div class="o_stat_info">
                        <span class="o_stat_text text-warning">Da Stampare</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         4. Action server: Segna come STAMPATI (batch dalla lista)
         NOTA: nelle server action XML non si possono usare import.
               datetime.datetime è disponibile nel contesto safe_eval.
         ================================================================ -->
    <record id="action_server_mark_label_printed" model="ir.actions.server">
        <field name="name">Segna come Stampati</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
now = datetime.datetime.now()
for record in records:
    record.with_context(skip_label_reset=True).write({
        'label_printed': True,
        'label_printed_date': now,
    })
        </field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
    </record>

    <!-- ================================================================
         5. Action server: Resetta flag (batch dalla lista)
         ================================================================ -->
    <record id="action_server_reset_label_printed" model="ir.actions.server">
        <field name="name">Reset "Etichetta stampata"</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
for record in records:
    record.with_context(skip_label_reset=True).write({
        'label_printed': False,
        'label_printed_date': False,
    })
        </field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
    </record>

</odoo>
