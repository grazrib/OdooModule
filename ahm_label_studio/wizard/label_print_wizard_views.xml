<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_label_print_wizard_form" model="ir.ui.view">
    <field name="name">label.print.wizard.form</field>
    <field name="model">label.print.wizard</field>
    <field name="arch" type="xml">
      <form string="Stampa etichette" class="o_form_label_wizard">
        <sheet>
          <!-- Wizard Fields -->
          <group>
            <field name="template_id" options="{'no_create': False}"/>
            <field name="quantity"/>
            <field name="start_position"/>
            <field name="update_label_flag"/>
          </group>

          <!-- ✅ Full-width centered preview -->
          <separator string="Anteprima" colspan="4"/>
          <div class="o_label_preview_box" style="width:100%; text-align:center; padding:10px 0;">
            <field name="preview_note" nolabel="1" readonly="1" widget="html"
                   style="width:100%; max-height:250px; overflow:auto; border:1px solid #ddd; border-radius:4px;"/>
          </div>
        </sheet>

        <!-- Footer Buttons -->
        <footer>
          <button name="action_print" string="Stampa PDF" type="object" class="btn-primary"/>
          <button string="Annulla" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
