<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- ========== PREDEFINED DYMO LABEL TEMPLATE ========== -->
    <record id="label_template_dymo_1x1" model="label.template">
      <field name="name">Dymo Label 1 x 1</field>
      <field name="model_id" ref="product.model_product_template"/>
      <field name="paperformat_id" search="[('name','=','Dymo Label Sheet')]"/>

     
      <field name="label_width_mm">57</field>
      <field name="label_height_mm">32</field>
      <field name="columns">1</field>
      <field name="rows">1</field>
      <field name="margin_left_mm">0</field>
      <field name="margin_top_mm">0</field>
      <field name="h_spacing_mm">0</field>
      <field name="v_spacing_mm">0</field>
      <field name="default_barcode_type">Code128</field>
      <field name="show_barcode_human_readable" eval="False"/>
      <field name="label_border_style">dashed</field>
      <field name="currency_symbol">$</field>
      <field name="currency_position">before</field>
    </record>

    <!-- ========== LABEL FIELDS ========== -->
    <!-- Product Name -->
    <record id="label_template_dymo_1x1_field_name" model="label.template.line">
      <field name="template_id" ref="label_template_dymo_1x1"/>
      <field name="field_id" search="[('model','=','product.template'),('name','=','name')]"/>
      <field name="display_type">text</field>
      <field name="x_pos">5</field>
      <field name="y_pos">3</field>
      <field name="font_size">9</field>
      <field name="bold">True</field>
    </record>

    <!-- Product Price -->
    <record id="label_template_dymo_1x1_field_price" model="label.template.line">
      <field name="template_id" ref="label_template_dymo_1x1"/>
      <field name="field_id" search="[('model','=','product.template'),('name','=','list_price')]"/>
      <field name="display_type">text</field>
      <field name="x_pos">45</field>
      <field name="y_pos">3</field>
      <field name="font_size">10</field>
      <field name="bold">True</field>
      <field name="color">#007700</field>
    </record>

    <!-- Barcode -->
    <record id="label_template_dymo_1x1_field_barcode" model="label.template.line">
      <field name="template_id" ref="label_template_dymo_1x1"/>
      <field name="field_id" search="[('model','=','product.template'),('name','=','barcode')]"/>
      <field name="display_type">barcode</field>
      <field name="barcode_type">Code128</field>
      <field name="show_human_readable" eval="False"/>
      <field name="x_pos">5</field>
      <field name="y_pos">10</field>
      <field name="width_mm">47</field>
      <field name="height_mm">15</field>
    </record>

    <!-- Barcode -->
    <record id="label_template_dymo_1x1_field_barcode_text" model="label.template.line">
      <field name="template_id" ref="label_template_dymo_1x1"/>
      <field name="field_id" search="[('model','=','product.template'),('name','=','barcode')]"/>
      <field name="display_type">text</field>
      <field name="show_human_readable" eval="False"/>
      <field name="x_pos">20</field>
      <field name="y_pos">25</field>
      <field name="width_mm">47</field>
      <field name="height_mm">10</field>
    </record>

     

  </data>
</odoo>
